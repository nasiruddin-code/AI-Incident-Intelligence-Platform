# Copy to .env (same folder as docker-compose.yml) and fill in.
# .env is git-ignored: never commit real passwords.

# Who receives incident emails (JSON list; several addresses allowed)
NOTIFY_EMAIL_TO=["you@example.com"]

# --- Real delivery, e.g. Gmail (needs 2-Step Verification + an App Password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# NOTIFY_EMAIL_FROM=you@gmail.com

# Leave the SMTP_* lines commented out to keep using the local Mailpit inbox.

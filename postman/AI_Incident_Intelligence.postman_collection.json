              }
            ],
            "url": "{{ai_base}}/api/v1/telemetry/logs",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"2026-09-30T10:00:00Z\",\n  \"severity\": \"ERROR\",\n  \"body\": \"Payment FAILED gateway timeout\",\n  \"attributes\": {},\n  \"resource\": {\n    \"service_name\": \"payment-service\",\n    \"service_version\": \"0.1.0\",\n    \"environment\": \"development\",\n    \"attributes\": {}\n  },\n  \"trace_id\": \"abc123trace\",\n  \"span_id\": \"span001\"\n}"
            }
          }
        },
        {
          "name": "Ingest Metric Point",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/telemetry/metrics",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"payments_total\",\n  \"type\": \"COUNTER\",\n  \"value\": 5,\n  \"timestamp\": \"2026-09-30T10:00:00Z\",\n  \"attributes\": {\n    \"status\": \"failed\"\n  },\n  \"resource\": {\n    \"service_name\": \"payment-service\",\n    \"attributes\": {}\n  }\n}"
            }
          }
        },
        {
          "name": "Ingest Span",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",

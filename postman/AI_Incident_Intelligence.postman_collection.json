              }
            ],
            "url": "{{ai_base}}/api/v1/telemetry/traces",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trace_id\": \"abc123trace\",\n  \"span_id\": \"span001\",\n  \"name\": \"payment.process\",\n  \"start_time\": \"2026-09-30T10:00:00Z\",\n  \"end_time\": \"2026-09-30T10:00:02Z\",\n  \"status\": \"ERROR\",\n  \"attributes\": {},\n  \"resource\": {\n    \"service_name\": \"payment-service\",\n    \"attributes\": {}\n  }\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Incidents",
      "item": [
        {
          "name": "Create Incident Shell",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/incidents",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment outage (manual shell)\",\n  \"severity\": \"ERROR\",\n  \"affected_services\": [\n    \"payment-service\",\n    \"order-service\"\n  ],\n  \"notes\": \"Created from Postman\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  const id = d.incident_id || (d.incident && d.incident.incident_id);",
                  "  if (id) pm.collectionVariables.set('incident_id', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Build Context from Evidence",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/incidents/context",
            "description": "Week 8 \u2014 builds IncidentContext; saves incident_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Payment gateway timeout\",\n  \"severity\": \"ERROR\",\n  \"affected_services\": [\n    \"order-service\",\n    \"payment-service\"\n  ],\n  \"scenario\": \"payment_timeout\",\n  \"logs\": [\n    {\n      \"timestamp\": \"2026-09-30T10:00:00Z\",\n      \"severity\": \"ERROR\",\n      \"body\": \"Payment FAILED gateway timeout\",\n      \"attributes\": {},\n      \"resource\": {\n        \"service_name\": \"payment-service\",\n        \"attributes\": {}\n      },\n      \"trace_id\": \"trace-postman-001\",\n      \"span_id\": \"span-pay-1\"\n    },\n    {\n      \"timestamp\": \"2026-09-30T10:00:00Z\",\n      \"severity\": \"ERROR\",\n      \"body\": \"Order PAYMENT_FAILED order_id=ord-1\",\n      \"attributes\": {},\n      \"resource\": {\n        \"service_name\": \"order-service\",\n        \"attributes\": {}\n      },\n      \"trace_id\": \"trace-postman-001\",\n      \"span_id\": \"span-ord-1\"\n    }\n  ],\n  \"metrics\": [\n    {\n      \"name\": \"payments_total\",\n      \"type\": \"COUNTER\",\n      \"value\": 8,\n      \"timestamp\": \"2026-09-30T10:00:00Z\",\n      \"attributes\": {\n        \"status\": \"failed\"\n      },\n      \"resource\": {\n        \"service_name\": \"payment-service\",\n        \"attributes\": {}\n      }\n    }\n  ],\n  \"traces\": [\n    {\n      \"trace_id\": \"trace-postman-001\",\n      \"span_id\": \"span-ord-1\",\n      \"name\": \"order.create\",\n      \"start_time\": \"2026-09-30T10:00:00Z\",\n      \"end_time\": \"2026-09-30T10:00:02Z\",\n      \"status\": \"ERROR\",\n      \"attributes\": {},\n      \"resource\": {\n        \"service_name\": \"order-service\",\n        \"attributes\": {}\n      }\n    },\n    {\n      \"trace_id\": \"trace-postman-001\",\n      \"span_id\": \"span-pay-1\",\n      \"parent_span_id\": \"span-ord-1\",\n      \"name\": \"payment.process\",\n      \"start_time\": \"2026-09-30T10:00:00Z\",\n      \"end_time\": \"2026-09-30T10:00:02Z\",\n      \"status\": \"ERROR\",\n      \"attributes\": {},\n      \"resource\": {\n        \"service_name\": \"payment-service\",\n        \"attributes\": {}\n      }\n    }\n  ],\n  \"notes\": \"Postman sample with correlated evidence\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  const id = d.incident_id || (d.incident && d.incident.incident_id);",
                  "  if (id) pm.collectionVariables.set('incident_id', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Run Failure Scenario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/incidents/scenarios/run",
            "description": "From host use localhost:8001. Inside Docker network use http://order-service:8001.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scenario\": \"payment_timeout\",\n  \"order_count\": 5,\n  \"order_service_url\": \"http://localhost:8001\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  const id = d.incident_id || (d.incident && d.incident.incident_id);",
                  "  if (id) pm.collectionVariables.set('incident_id', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Incidents",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents?limit=50&offset=0",
            "description": "Paginated, newest first. Optional filters: status, severity. Response includes count, total, limit, offset."
          }
        },
        {
          "name": "List Incident Summaries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/summaries?limit=50&offset=0",
            "description": "Lightweight list (no logs/metrics/traces). Optional filters: status, severity."
          }
        },
        {
          "name": "Get Incident by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}",
            "description": ""
          }
        },
        {
          "name": "Update Incident Status",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}/status?new_status=INVESTIGATING",
            "description": "OPEN | INVESTIGATING | RESOLVED | CLOSED"
          }
        }
      ]
    },
    {
      "name": "5. Correlation / RCA / Runbook",
      "item": [
        {
          "name": "Enrich Incident (live telemetry)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"lookback_seconds\": 900\n}" },
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}/enrich",
            "description": "Pulls logs (Loki), metrics (Prometheus) and traces (Tempo) for the incident's services and time window. Safe to re-run."
          }
        },
        {
          "name": "Correlate Incident",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}/correlate",
            "description": "Week 9 \u2014 links, anomalies, severity score."
          }
        },
        {
          "name": "Run RCA",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}/rca?run_correlation=true",
            "description": "Week 10 \u2014 AI root cause analysis."
          }
        },
        {
          "name": "Generate Runbook",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{ai_base}}/api/v1/incidents/{{incident_id}}/runbook",
            "description": "Week 11 \u2014 steps + remediation + verification."
          }
        }
      ]
    },
    {
      "name": "6. Investigation Agent",
      "item": [
        {
          "name": "Agent Investigate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/agent/investigate",
            "description": "Week 12 \u2014 full tool chain.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incident_id\": \"{{incident_id}}\",\n  \"question\": \"What caused the payment failures?\",\n  \"run_correlation\": true,\n  \"run_rca\": true,\n  \"run_runbook\": true\n}"
            }
          }
        },
        {
          "name": "Agent Investigate (latest)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/agent/investigate",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Summarize the most recent incident\",\n  \"run_correlation\": true,\n  \"run_rca\": true,\n  \"run_runbook\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "7. Observability Queries",
      "item": [
        {
          "name": "Observability Health",
          "request": {
            "method": "GET",
            "header": [],

    {
      "name": "8. E2E Workflow",
      "item": [
        {
          "name": "Run Full E2E Pipeline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/e2e/run",
            "description": "Week 15 \u2014 context \u2192 correlate \u2192 RCA \u2192 runbook.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman E2E payment failure drill\",\n  \"simulate_payment_failure\": true,\n  \"run_correlation\": true,\n  \"run_rca\": true,\n  \"run_runbook\": true,\n  \"check_observability\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  const id = d.incident_id || (d.incident && d.incident.incident_id);",
                  "  if (id) pm.collectionVariables.set('incident_id', id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Alertmanager Webhook (sample firing alert)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/alerts/alertmanager",
            "description": "What Alertmanager sends. Opens an incident and investigates it in the background; send again with status=resolved to resolve it.",

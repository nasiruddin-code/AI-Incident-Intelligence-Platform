{
  "info": {
    "name": "AI Incident Intelligence Platform",
    "description": "Complete API collection for the AI Observability / Incident Intelligence MVP (Weeks 1\u201316).\n\nServices:\n- AI Service :8000\n- Order Service :8001\n- Payment Service :8002\n\nSuggested flow: Health \u2192 Create Order \u2192 Build Context \u2192 Correlate \u2192 RCA \u2192 Runbook \u2192 Agent \u2192 E2E.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "ai_base",
      "value": "http://localhost:8000"
    },
    {
      "key": "order_base",
      "value": "http://localhost:8001"
    },
    {
      "key": "payment_base",
      "value": "http://localhost:8002"
    },
    {
      "key": "incident_id",
      "value": ""
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "order_id",
      "value": ""
    },
    {
      "key": "payment_id",
      "value": ""
    },
    {
      "key": "trace_id",
      "value": ""
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "AI Service \u2014 Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ai_base}}/api/v1/health",
            "description": "AI service liveness."
          }
        },
        {
          "name": "AI Service \u2014 Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{ai_base}}/api/v1/health/ready",
            "description": "Shows active AI provider."
          }
        },
        {
          "name": "Order Service \u2014 Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base}}/api/v1/health",
            "description": ""
          }
        },
        {
          "name": "Order Service \u2014 Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base}}/api/v1/health/ready",
            "description": "Pings payment-service."
          }
        },
        {
          "name": "Payment Service \u2014 Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/health",
            "description": ""
          }
        },
        {
          "name": "Payment Service \u2014 Ready",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/health/ready",
            "description": ""
          }
        }
      ]
    },
    {
      "name": "1. Sample Microservices",
      "item": [
        {
          "name": "Create Order (calls Payment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{order_base}}/api/v1/orders",
            "description": "Creates order and calls payment-service. Saves order_id/payment_id.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"postman-cust-1\",\n  \"items\": [\n    {\n      \"sku\": \"SKU-001\",\n      \"name\": \"Widget\",\n      \"quantity\": 2,\n      \"unit_price\": 19.99\n    }\n  ],\n  \"currency\": \"USD\",\n  \"payment_method\": \"card\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  if (d.order_id) pm.collectionVariables.set('order_id', d.order_id);",
                  "  if (d.payment_id) pm.collectionVariables.set('payment_id', d.payment_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base}}/api/v1/orders/{{order_id}}",
            "description": ""
          }
        },
        {
          "name": "List Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{order_base}}/api/v1/orders",
            "description": ""
          }
        },
        {
          "name": "Create Payment (direct)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{payment_base}}/api/v1/payments",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"order_id\": \"manual-ord-1\",\n  \"amount\": 49.99,\n  \"currency\": \"USD\",\n  \"customer_id\": \"postman-cust-1\",\n  \"payment_method\": \"card\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const d = pm.response.json();",
                  "  if (d.payment_id) pm.collectionVariables.set('payment_id', d.payment_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/payments/{{payment_id}}",
            "description": ""
          }
        },
        {
          "name": "List Payments by Order",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/payments/by-order/{{order_id}}",
            "description": ""
          }
        },
        {
          "name": "Payment Fault Injection \u2014 Get",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{payment_base}}/api/v1/fault-injection",
            "description": "Current runtime failure settings."
          }
        },
        {
          "name": "Payment Fault Injection \u2014 Set",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{payment_base}}/api/v1/fault-injection",
            "description": "Change failure injection without restarting payment-service.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failure_rate\": 1.0,\n  \"latency_ms\": 0\n}"
            }
          }
        },
        {
          "name": "Payment Fault Injection \u2014 Reset",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{payment_base}}/api/v1/fault-injection",
            "description": "Back to FAILURE_RATE / LATENCY_MS from env."
          }
        }
      ]
    },
    {
      "name": "2. Log Analysis",
      "item": [
        {
          "name": "Analyze Log",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{ai_base}}/api/v1/logs/analyze",
            "description": "Week 2-3 AI log analysis (mock or Gemini).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"log_content\": \"2026-09-30T10:00:00Z ERROR OrderService: connection timeout to PaymentService after 5000ms\",\n  \"service_name\": \"order-service\",\n  \"context\": \"Started right after a deploy\"\n}"
            }
          }

// Grafana Alloy: read-only log collection for the log monitor.
//
// 1. Container logs: every container on this Docker host (any compose project,
//    any network), read through docker-proxy, which only allows GET requests to
//    the Docker API. Nothing is installed in, or changed on, the watched apps.
// 2. Log files: *.log under /var/log/watched (a read-only bind mount), for apps
//    that write files instead of stdout. The file name becomes service_name.
//
// Both are labelled source=docker|file; ai-service's log monitor reads
// {source=~"docker|file"} from Loki.

discovery.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  refresh_interval = "10s"
}

discovery.relabel "containers" {
  targets = []

  // service_name = compose service name, else the container name
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }
  // Scope (optional): only these compose projects (regex; ".*" = every container),
  // and never containers labelled logmon.ignore=true
  rule {
    source_labels = ["compose_project"]
    regex         = sys.env("LOGMON_WATCH_PROJECTS")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_logmon_ignore"]
    regex         = "true"
    action        = "drop"
  }
  // The monitoring platform itself is not an application to watch
  rule {
    source_labels = ["service_name"]
    regex         = "loki|prometheus|alertmanager|tempo|grafana|otel-collector|alloy|docker-proxy|postgres|mailpit"
    action        = "drop"
  }
  rule {
    target_label = "source"
    replacement  = "docker"
  }
}

loki.source.docker "containers" {
  host             = "tcp://docker-proxy:2375"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.containers.rules
  refresh_interval = "10s"
  forward_to       = [loki.write.local.receiver]
}

local.file_match "files" {
  path_targets = [{"__path__" = "/var/log/watched/*.log"}]
  sync_period  = "10s"
}

loki.source.file "files" {
  targets    = local.file_match.files.targets
  forward_to = [loki.process.files.receiver]
}

loki.process "files" {
  // filename label "/var/log/watched/legacy-billing.log" -> service_name="legacy-billing"
  stage.static_labels {
    values = { source = "file" }
  }
  stage.regex {
    expression = "^/var/log/watched/(?P<service_name>[^/]+?)\\.log$"
    source     = "filename"
  }
  stage.labels {
    values = { service_name = "" }
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

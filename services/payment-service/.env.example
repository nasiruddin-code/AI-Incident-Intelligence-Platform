APP_NAME=payment-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]
LOG_LEVEL=INFO
SERVICE_NAME=payment-service

# Failure injection for Week 8 incident scenarios
# payment_timeout:        FAILURE_RATE=1.0
# payment_high_latency:   LATENCY_MS=2000
# payment_cascade_failure: FAILURE_RATE=0.6  LATENCY_MS=800
FAILURE_RATE=0.0
LATENCY_MS=0
# Change the above at runtime (no restart): GET/PUT/DELETE /api/v1/fault-injection
# Enabled except when ENVIRONMENT=production unless set explicitly.
# FAULT_INJECTION_API_ENABLED=true
# Require X-Fault-Token on those calls (set the same value as
# PAYMENT_FAULT_INJECTION_TOKEN in ai-service):
FAULT_INJECTION_TOKEN=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=payment-service

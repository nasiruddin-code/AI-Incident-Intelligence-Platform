# Copy to .env and adjust as needed.

APP_NAME=ai-service
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

LOG_LEVEL=INFO
# text (local) | json (docker-compose sets json)
LOG_FORMAT=text

# Primary model: mock (no key) | gemini | anthropic | openai | ollama
AI_PROVIDER=mock
# Other real providers to try, in order, if the primary fails (JSON list),
# e.g. ["anthropic","ollama"]. The mock fallback (AI_ENABLE_FALLBACK) comes last.
AI_FALLBACK_PROVIDERS=[]
AI_REQUEST_TIMEOUT_SECONDS=120

# Cache structured answers from real models (identical prompt -> cached answer).
# 0 disables. Responses carry usage.cached=true when served from cache.
AI_CACHE_TTL_SECONDS=3600
AI_CACHE_MAX_ENTRIES=500
# Prices for the ai_llm_cost_usd_total estimate: model -> [USD/1M input, USD/1M output].
# Defaults cover current Claude models; add entries for other models you use.
# AI_MODEL_PRICES={"claude-opus-5-5":[4,20],"gemini-2.5-flash":[<in>,<out>]}

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude. Leave the key empty to use the SDK's own credentials (e.g. `ant auth login`).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_TOKENS=16000
# Server-side refusal fallback (fallbacks: "default")
ANTHROPIC_SERVER_FALLBACKS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Local models via Ollama's OpenAI-compatible endpoint (no key)
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_MODEL=llama3.1

# Investigation agent: auto (model-driven planner when a real provider is set,
# fixed pipeline with mock) | planner | fixed
AGENT_MODE=auto

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Week 13 – real observability backends (docker network names)
PROMETHEUS_URL=http://prometheus:9090
LOKI_URL=http://loki:3100
TEMPO_URL=http://tempo:3200
OBSERVABILITY_TIMEOUT_SECONDS=10

# Live-telemetry enrichment (POST /incidents/{id}/enrich)
ENRICH_LOOKBACK_SECONDS=900
ENRICH_MAX_LOGS_PER_SERVICE=100
ENRICH_MAX_METRICS_PER_SERVICE=50
ENRICH_MAX_TRACES_PER_SERVICE=5
ENRICH_METRIC_PREFIX=otel_

# Similar incidents: how many go into the RCA prompt (0 disables) and the minimum score
SIMILAR_IN_RCA=3
SIMILAR_MIN_SCORE=0.35

# Baseline anomaly detection (POST /incidents/{id}/baseline)
BASELINE_ENABLED=true
BASELINE_LOOKBACK_SECONDS=3600
BASELINE_GAP_SECONDS=60
BASELINE_MIN_WINDOW_SECONDS=300
BASELINE_STEP_SECONDS=30
BASELINE_MIN_POINTS=10
BASELINE_Z_THRESHOLD=3.0

# Log monitor: reads Loki (read-only) for error patterns and opens incidents.
# docker-compose.yml turns it on; leave false for local runs without Loki.
LOG_MONITOR_ENABLED=false
LOG_MONITOR_INTERVAL_SECONDS=30
LOG_MONITOR_QUERY={source=~"docker|file"}
LOG_MONITOR_NEW_PATTERN_MIN_COUNT=2
LOG_MONITOR_MIN_COUNT=3
LOG_MONITOR_Z_THRESHOLD=3.0
LOG_MONITOR_RESOLVE_AFTER_SECONDS=300
LOG_MONITOR_RECURRING_DAYS=7
LOG_MONITOR_EXCLUDE_SERVICES=[]
LOG_MONITOR_INVESTIGATE=true

# Email reports (SMTP). Local POC: Mailpit, inbox at http://localhost:8025
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
NOTIFY_EMAIL_FROM=incident-bot@localhost
NOTIFY_EMAIL_TO=[]
NOTIFY_EMAIL_EVENTS=["incident_created","runbook_completed","incident_resolved"]
UI_BASE_URL=

# Alertmanager webhook (POST /api/v1/alerts/alertmanager): what runs for new alerts
ALERT_AUTO_INVESTIGATE=true
ALERT_AUTO_ENRICH=true
ALERT_AUTO_RCA=true
ALERT_AUTO_RUNBOOK=true

# Must match payment-service FAULT_INJECTION_TOKEN if that is set
PAYMENT_FAULT_INJECTION_TOKEN=

# Week 15 – resilience + security
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
AI_ENABLE_FALLBACK=true
ENABLE_AUTH=false
# Full-access key
API_KEY=
# Named keys with scopes read | write | ai | alerts | * (keys >= 16 chars), e.g.
# API_KEYS={"grafana":{"key":"...","scopes":["read"]},"alertmanager":{"key":"...","scopes":["alerts"]}}
API_KEYS={}
ALLOW_API_KEY_QUERY_PARAM=false

# Per-client rate limits (per process)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=300
AI_RATE_LIMIT_PER_MINUTE=30

# Notifications: incident_created | rca_completed | runbook_completed | incident_resolved
NOTIFY_SLACK_WEBHOOK_URL=
NOTIFY_WEBHOOK_URLS=[]
NOTIFY_WEBHOOK_SECRET=
NOTIFY_MIN_SEVERITY=WARN
PUBLIC_BASE_URL=

# Persistence — leave empty for in-memory (tests/local without Postgres)
# Docker Compose sets this automatically for ai-service.
DATABASE_URL=postgresql+psycopg2://ai:ai@postgres:5432/ai_incidents
